---
import { site } from '../data/site';
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="site-header">
  <div class="wrap">
    <a class="site-logo" href="/" aria-label={`${site.name} home`}>
      <svg class="logo-mark" viewBox="0 0 32 32" fill="none" aria-hidden="true">
        <circle cx="16" cy="16" r="14" fill="#f3ecd8" />
        <path d="M16 26c0-8 2-12 8-14-2 8-3 11-8 14z" fill="#5a9e3a" />
        <path d="M16 26c0-8-2-12-8-14 2 8 3 11 8 14z" fill="#4a8630" />
        <path d="M16 26V14" stroke="#8b5e3c" stroke-width="2" stroke-linecap="round" />
        <circle cx="16" cy="10" r="3" fill="#d9a441" />
      </svg>
      {site.name}
    </a>
    <nav class="site-nav" aria-label="Main navigation">
      <a href="/tools/" aria-current={isActive('/tools') ? 'page' : undefined}>All tools</a>
      <a href="/crop-profit-calculator/" aria-current={isActive('/crop-profit') ? 'page' : undefined}>Crop profit</a>
      <a href="/best-crop-calculator/" aria-current={isActive('/best-crop') ? 'page' : undefined}>Best crop</a>
      <a href="/keg-calculator/" aria-current={isActive('/keg') ? 'page' : undefined}>Kegs &amp; jars</a>
      <a href="/crop-profit-calculator/" aria-current={isActive('/animal') ? 'page' : undefined}>Animals</a>
      <a href="/guides/" aria-current={isActive('/guides') ? 'page' : undefined}>Guides</a>
    </nav>
  </div>
</header>
