---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { site } from '../../data/site';

const title = 'Changelog: What Changed and When | StardewTools';
const description = 'Real, dated updates to StardewTools calculators and game data. No cosmetic date bumps: every entry lists what actually changed.';

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Changelog' },
];

const entries = [
  {
    date: '2026-10-08',
    title: 'Initial release',
    items: [
      'Launched the crop profit calculator with artisan processing (keg + jar) support.',
      'Launched the best-crop finder for the days you have left in the season.',
      'Compiled crop data from the Stardew Valley Wiki (prices, growth times, processing).',
      'All maths client-side; no accounts, no uploads.',
    ],
  },
];
---

<Base title={title} description={description} breadcrumbs={breadcrumbs} canonical="/changelog/">
  <div class="wrap-narrow">
    <Breadcrumbs items={breadcrumbs} />

    <h1>Changelog</h1>
    <p class="lead">
      What actually changed, when, and why. We only touch dates when there is a real update behind them.
    </p>

    {entries.map((e) => (
      <section class="section">
        <h2 id={e.date} style="margin-top:0">{e.date}: {e.title}</h2>
        <ul>
          {e.items.map((i) => <li>{i}</li>)}
        </ul>
      </section>
    ))}

    <section class="section">
      <h2 id="planned">Planned</h2>
      <ul>
        <li>Animal profit calculator with processing (mayonnaise, cheese, oil).</li>
        <li>Fish pond profit tracker.</li>
        <li>Greenhouse payout planner (ancient fruit vs starfruit debates, resolved with maths).</li>
      </ul>
      <p class="small muted">Plans are not promises; entries move to a dated release when they ship.</p>
    </section>
  </div>
</Base>
